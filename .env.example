# AI provider keys — required for the app to generate lessons and images.
# Get a free key from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key

# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# Optional: Render PostgreSQL connection string.
# Only needed if you add server-side accounts or progress persistence.
DATABASE_URL=postgresql://user:password@host:5432/database

NODE_ENV=development
